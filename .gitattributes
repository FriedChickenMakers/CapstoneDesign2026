# Unity text assets should remain diffable and mergeable.
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.shader     text eol=lf
*.asmdef     text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.cs         text eol=lf
*.sh         text eol=lf

# Large optional binary art can be added through Git LFS later.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
